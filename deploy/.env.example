# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=
# >= 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Public origin of the frontend (no trailing slash), e.g. https://eoc.example.org
CORS_ORIGINS=
# Public URL browsers use to reach the backend, e.g. https://api.eoc.example.org
PUBLIC_API_BASE=
# Optional: shown on /signup and /forgot-password
# Optional MapLibre style URL (self-hosted/licensed basemap). Empty = CARTO public dark style.
MAP_STYLE_URL=
# Optional: enables LLM reasoning; everything falls back to rule-based logic without it
GROQ_API_KEY=
# Secret for the public citizen assistant's device credential (also used by the seed step)
CITIZEN_DEVICE_SECRET=
# First-run admin account (used by `run --rm seed`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
