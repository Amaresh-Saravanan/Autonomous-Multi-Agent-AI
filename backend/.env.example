# Copy to .env (already gitignored) and fill in real values for local dev.
# TLS-in-transit is a deployment-time concern (reverse proxy / uvicorn --ssl-keyfile
# --ssl-certfile), not something this local dev setup handles -- ponytail: deferred
# until real deployment.

# Optional -- enables LLM reasoning in agents; falls back to rule-based logic without it.
GROQ_API_KEY=

# Optional -- enables Redis-backed blackboard; falls back to in-memory without it.
REDIS_URL=

# Required for RBAC (tracker 3.4) once app/auth.py lands -- signs/verifies JWTs.
# app/auth.py falls back to a dev-only default if unset, with a loud warning logged --
# never rely on that fallback outside local dev.
JWT_SECRET=
