# --- Browser-visible (inlined at BUILD time; no secrets here) ---
# Public URL of backend-v2 (no trailing slash). Required for production builds.
NEXT_PUBLIC_API_BASE=http://localhost:8001
# Optional MapLibre style URL; empty uses the CARTO public dark style (third-party).
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Server-only (read at runtime by app/api/* proxy routes) ---
# Internal URL the Next server uses to reach the backend (defaults to NEXT_PUBLIC_API_BASE).
BACKEND_URL=http://localhost:8001
# Device credential for the public citizen assistant/report (created by `python -m app.seed`).
CITIZEN_DEVICE_ID=citizen-default
CITIZEN_DEVICE_SECRET=
# Demo "simulate sensor" button on /command. Leave disabled in production.
DEMO_INGEST_ENABLED=false
DEMO_IOT_DEVICE_ID=iot-default
DEMO_IOT_DEVICE_SECRET=
