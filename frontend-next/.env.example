# Backend V2 runs on :8001 (V1 is :8000 and is not what this frontend targets).
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Server-side only (no NEXT_PUBLIC_ prefix) — used by app/api/demo-ingest's
# route handler, which proxies the "simulate a sensor" demo button so the
# device secret never reaches the browser bundle. Values below match
# backend-v2/scripts/seed.py's defaults.
API_BASE=http://localhost:8001
DEMO_DEVICE_ID=demo-sensor-01
DEMO_DEVICE_SECRET=demo-secret-change-me
